# VoidBackups Environment Configuration
# Copy this to .env and fill in the values.

# Server
PORT=3010
APP_URL=http://localhost:3010

# WebAuthn / Passkey
# RP_NAME is the name shown during passkey registration
RP_NAME=VoidBackups
# RP_ID is the domain for passkey authentication (use your Tailscale hostname)
RP_ID=localhost

# CORS (comma-separated origins, or leave empty to use APP_URL)
ALLOWED_ORIGINS=

# Data directory (relative to project root)
DATA_DIR=./data

# Session duration in days
SESSION_DAYS=30

# Agent heartbeat interval in seconds
AGENT_HEARTBEAT_INTERVAL=30

# Agent offline threshold in seconds
AGENT_OFFLINE_THRESHOLD=90

# Vite dev proxy (for client dev server)
VITE_DEV_PROXY=http://localhost:3010
